<?xml version="1.0" encoding="utf-8"?>
<!-- 1×1 by default and resizable: ReminderWidgetProvider switches from the
     compact layout to the large one at about 2×2. The configuration
     activity asks which reminder to show when the widget is added; it can
     be changed later (reconfigurable). updatePeriodMillis is only a
     fallback: the app schedules exact redraws at every upcoming
     activation. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.example.just_reminder.WidgetConfigurationActivity"
    android:description="@string/widget_description"
    android:initialLayout="@layout/reminder_widget_small"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/reminder_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
