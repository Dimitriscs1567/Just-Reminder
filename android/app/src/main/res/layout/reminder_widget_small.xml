<?xml version="1.0" encoding="utf-8"?>
<!-- Compact layout (1×1, the default size): the thumb with a missed-count
     bubble above the display name, or a short label instead of the thumb
     when archived / deleted / not set up. The thumb is at most 48dp and
     shrinks when the widget is short (e.g. in landscape). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_neutral"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/widget_thumb_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/widget_thumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_all_clear"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_thumb_up" />

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/widget_count_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Regular and muted, so it reads as a status next to the bold name;
             shrinks to fit narrow cells. -->
        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.8"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_choose_short"
            android:textColor="@color/widget_on_neutral"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:hyphenationFrequency="normal"
        android:maxLines="2"
        android:text="@string/widget_default_title"
        android:textColor="@color/widget_on_neutral"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
