<?xml version="1.0" encoding="utf-8"?>
<!-- Large layout (from about 2×2): display name, thumb (up = clear,
     down = waiting), "N missed" badge, or a label when archived / deleted /
     not set up. Same view ids as reminder_widget_small. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_neutral"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_default_title"
        android:textColor="@color/widget_on_neutral"
        android:textSize="15sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/widget_thumb_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/widget_thumb"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="@string/widget_all_clear"
            android:src="@drawable/widget_thumb_up" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_badge_background"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/widget_choose"
        android:textColor="@color/widget_on_neutral"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
