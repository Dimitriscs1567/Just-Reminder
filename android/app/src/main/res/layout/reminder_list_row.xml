<?xml version="1.0" encoding="utf-8"?>
<!-- One reminder in the list widget: state icon (the teal ring is the Done
     button), display name and status ("Due · 1 missed", "Missed · 2",
     "Done", …). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="10dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_ripple_circle"
        android:contentDescription="@string/widget_state_done"
        android:padding="5dp"
        android:src="@drawable/widget_row_done" />

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_on_neutral"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/row_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:textColor="@color/widget_neutral_variant"
        android:textSize="12sp" />
</LinearLayout>
